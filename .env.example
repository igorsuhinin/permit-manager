APP_HTTP_PORT=8080
MYSQL_PORT=3307
MYSQL_DATABASE=permits
MYSQL_USER=permits
MYSQL_PASSWORD=permits_local
MYSQL_ROOT_PASSWORD=root_local

# Local step debugging: change to debug and recreate PHP with make up.
XDEBUG_MODE=off

# Optional path for app:setup and database initialization (default: protected/initial-settings.php).
INITIAL_SETTINGS_CONFIG=

# Optional private public-page/permit wording (defaults to protected/public-ui.php).
PUBLIC_UI_CONFIG=
# Optional private Twig/CSS overrides (defaults to protected/templates).
PUBLIC_TEMPLATE_DIRECTORY=

# Optional private initial blacklist; missing default file means an empty initial blacklist.
# Set this explicitly in production so a missing file fails initialization.
INITIAL_BLACKLIST_CONFIG=

# Optional Sentry error reporting and structured logs. Keep the real DSN private.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=

# Twig compilation cache: automatic outside local/test; 0 disables, 1 enables.
TWIG_CACHE_ENABLED=
# Optional private base directory; a physical-release/version namespace is appended.
TWIG_CACHE_DIRECTORY=
TWIG_CACHE_VERSION=
