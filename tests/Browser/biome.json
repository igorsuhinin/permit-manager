{
    "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
    "files": {
        "includes": ["**", "!package-lock.json"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "rules": {
            "preset": "recommended"
        }
    }
}
