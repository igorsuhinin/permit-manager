        "test": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@biomejs/biome": "2.6.8",
        "@playwright/test": "1.65.1",
        "jsqr": "1.4.0",
        "pngjs": "7.0.0"
    }
}
