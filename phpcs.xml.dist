<?xml version="1.0"?>
<ruleset name="Permit Manager">
    <description>PSR-12 and strict PHP checks, aligned with PER-CS 3.0 and Symfony formatting.</description>
    <arg name="extensions" value="php"/>
    <arg name="encoding" value="utf-8"/>
    <arg name="basepath" value="."/>
    <arg name="severity" value="1"/>
    <arg value="s"/>

    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <file>translations</file>
    <file>migrations</file>
    <file>bootstrap</file>
    <file>bin</file>
    <file>public/index.php</file>
    <file>rector.php</file>
    <file>.php-cs-fixer.dist.php</file>

    <rule ref="PSR12">
        <!-- PER-CS permits compact empty bodies; PHP-CS-Fixer enforces their formatting. -->
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine"/>
        <exclude name="PSR2.Classes.ClassDeclaration.OpenBraceNewLine"/>
        <!-- Keep alphabetically sorted imports without blank lines between import kinds. -->
        <exclude name="PSR12.Files.FileHeader.SpacingAfterUseBlock"/>
        <exclude name="PSR12.Files.FileHeader.SpacingAfterUseFunctionBlock"/>
        <exclude name="PSR12.Files.FileHeader.IncorrectGrouping"/>
        <exclude name="PSR12.Files.FileHeader.IncorrectOrder"/>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
            <property name="ignoreComments" value="false"/>
        </properties>
    </rule>
    <rule ref="Generic.PHP.RequireStrictTypes"/>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Generic.CodeAnalysis.EmptyPHPStatement"/>
    <rule ref="Generic.VersionControl.GitMergeConflict"/>
    <rule ref="Generic.NamingConventions.InterfaceNameSuffix"/>
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="var_dump" value="null"/>
                <element key="print_r" value="null"/>
                <element key="dump" value="null"/>
                <element key="dd" value="null"/>
            </property>
        </properties>
    </rule>
</ruleset>
