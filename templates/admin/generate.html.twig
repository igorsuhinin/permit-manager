{% extends 'admin/layout.html.twig' %}
{% set activePage = 'generate' %}
{% block title %}{{ 'generate'|trans(locale) }}{% endblock %}
{% block head %}
    <link href="/vendor/jquery-ui/1.14.2/jquery-ui.css" rel="stylesheet">
{% endblock %}
{% block content %}
{% set calendar = {
    dateFormat: 'dd.mm.yy', changeMonth: true, changeYear: true, showButtonPanel: true, firstDay: 1,
    prevText: 'previous'|trans(locale), nextText: 'next'|trans(locale),
    currentText: 'calendar.today'|trans(locale), closeText: 'calendar.close'|trans(locale),
    weekHeader: 'calendar.week'|trans(locale),
    selectMonthLabel: 'calendar.month'|trans(locale), selectYearLabel: 'calendar.year'|trans(locale),
    monthNames: 'calendar.months'|trans(locale)|split('|'),
    monthNamesShort: 'calendar.months_short'|trans(locale)|split('|'),
    dayNames: 'calendar.days'|trans(locale)|split('|'),
    dayNamesShort: 'calendar.days_short'|trans(locale)|split('|'),
    dayNamesMin: 'calendar.days_min'|trans(locale)|split('|')
} %}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h1 class="h3 mb-4">{{ 'generate'|trans(locale) }}</h1>
        {% include 'admin/error.html.twig' %}
        <div class="card shadow-sm p-4">
            <form action="/admin/permits/generate" method="post"{% if error %} aria-describedby="form-error"{% endif %}>
                    <input type="hidden" name="csrf" value="{{ csrf }}">
                    <div class="mb-3">
                        <label for="id" class="form-label">{{ 'permit_id'|trans(locale) }}</label>
                        <input type="text" class="form-control" id="id" name="id" value="{{ data.id|default('') }}" placeholder="{{ 'permit_id'|trans(locale) }}" required>
                    </div>
                    <div class="mb-3">
                        <label for="plate" class="form-label">{{ 'plate'|trans(locale) }}</label>
                        <input type="text" class="form-control" id="plate" name="plate" value="{{ data.plate|default('') }}" placeholder="{{ 'plate'|trans(locale) }}" required>
                    </div>
                    <div class="mb-3">
                        <label for="term" class="form-label">{{ 'valid_until'|trans(locale) }}</label>
                        <input type="text" class="form-control" id="term" name="term" data-datepicker-options="{{ calendar|json_encode }}" data-datepicker-label="{{ 'calendar.label'|trans(locale) }}" autocomplete="off" value="{{ data.term|default('') }}" placeholder="{{ 'date_format'|trans(locale) }}" aria-describedby="date-help{% if error == 'error.expiration' %} form-error{% endif %}"{% if error == 'error.expiration' %} aria-invalid="true"{% endif %} required>
                        <p id="date-help" class="form-text mb-0">{{ 'calendar.instructions'|trans(locale) }}</p>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="guest" name="guest"{% if data.guest is defined %} checked{% endif %}>
                        <label class="form-check-label" for="guest">{{ 'guest_permit'|trans(locale) }}</label>
                    </div>
                    <div class="mb-3">
                        <label for="apt" class="form-label">{{ 'apartment'|trans(locale) }}</label>
                        <input type="text" class="form-control" id="apt" name="apt" value="{{ data.apt|default('') }}" placeholder="{{ 'apartment'|trans(locale) }}" required>
                    </div>
                    <div class="d-flex justify-content-center w-100">
                        <button type="submit" class="btn btn-primary w-50">{{ 'generate'|trans(locale) }}</button>
                    </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
{% block scripts %}
<script defer src="/vendor/jquery/4.0.0/jquery.min.js"></script>
<script defer src="/vendor/jquery-ui/1.14.2/jquery-ui.min.js"></script>
<script defer src="/assets/datepicker.js"></script>
{% endblock %}
