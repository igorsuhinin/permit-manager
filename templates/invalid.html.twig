<!DOCTYPE html>
<html lang="lv">
<head>
    <meta charset="UTF-8">
    <title>{{ public_text('check.title') }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

    <link rel="stylesheet" href="/permit/check.css">
    <style nonce="{{ cspNonce }}">
        {% include 'public-check.css.twig' ignore missing %}
    </style>
</head>
<body>
<div class="wrapper">
    <div class="qr status-invalid" aria-hidden="true"></div>
    <h1 class="">{{ public_text('check.permit') }}</h1>
    <h2 class="not-valid">{{ public_text('check.invalid') }}</h2>
    <h1 class="smaller">{{ public_text('check.reason_label') }}</h1>
    <h1 class="smaller">{{ public_reason(reason) }}</h1>
</div>

</body>
</html>
